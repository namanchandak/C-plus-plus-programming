{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Run C++17",
            "type": "shell",
            "command": "/opt/homebrew/bin/g++-15 -std=c++17 -o ${workspaceFolder}/demo ${workspaceFolder}/demo.cpp && ${workspaceFolder}/demo < ${workspaceFolder}/input.txt > ${workspaceFolder}/output.txt",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "never",
                "close": true,
                "panel": "dedicated"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
